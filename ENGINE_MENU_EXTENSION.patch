+package legend.game.inventory.screens;
+
+import legend.core.lang.I18nText;
+import legend.core.platform.input.InputAction;
+import legend.game.inventory.screens.controls.Background;
+import legend.game.inventory.screens.controls.Label;
+import legend.game.inventory.screens.controls.ListBox;
+import legend.game.inventory.screens.controls.Panel;
+import legend.game.modding.events.menu.ExtensionMenuEntry;
+
+import java.util.List;
+
+import static legend.game.Menus.deallocateRenderables;
+import static legend.game.modding.coremod.CoreMod.INPUT_ACTION_MENU_BACK;
+import static legend.game.sound.Audio.playMenuSound;
+
+/** Native generic submenu for mod-contributed Main Menu destinations. */
+public final class ExtensionMenuScreen extends MenuScreen {
+  static final int VISIBLE_ROWS = 7;
+
+  private final Runnable unload;
+  private boolean initialized;
+  private final ListBox<ExtensionMenuEntry> entries;
+
+  public ExtensionMenuScreen(final List<ExtensionMenuEntry> entries, final Runnable unload) {
+    this.unload = unload;
+
+    this.addControl(new Background());
+    final Panel panel = this.addControl(Panel.panel());
+    panel.setPos(80, 24);
+    panel.setSize(208, 166);
+
+    final Label title = this.addControl(new Label(new I18nText("lod_core.ui.extension_menu.title")));
+    title.setPos(90, 35);
+    title.setSize(188, 14);
+    title.getFontOptions().horizontalAlign(HorizontalAlign.CENTRE);
+
+    this.entries = this.addControl(new ListBox<>(entry -> entry.name().get(), null, null, null, null));
+    this.entries.setPos(90, 55);
+    this.entries.setSize(188, VISIBLE_ROWS * 17);
+    entries.forEach(this.entries::add);
+    this.entries.onSelection(this::open);
+    this.setFocus(this.entries);
+
+    this.addHotkey(new I18nText("lod_core.ui.extension_menu.back"), INPUT_ACTION_MENU_BACK, this::back);
+  }
+
+  static MenuScreen createScreen(final ExtensionMenuEntry entry, final Runnable unload) {
+    return entry.screenFactory().apply(unload);
+  }
+
+  private void open(final ExtensionMenuEntry entry) {
+    playMenuSound(2);
+    this.getStack().pushScreen(createScreen(entry, () -> this.getStack().popScreen()));
+  }
+
+  private void back() {
+    playMenuSound(3);
+    this.unload.run();
+  }
+
+  @Override
+  protected void render() {
+    if(!this.initialized) {
+      // MainMenuScreen leaves its legacy timestamp separator glyphs allocated.
+      // Clear those before drawing the extension screen so they cannot bleed through.
+      deallocateRenderables(0xff);
+      deallocateRenderables(0);
+      this.initialized = true;
+    }
+  }
+
+  @Override
+  protected InputPropagation inputActionPressed(final InputAction action, final boolean repeat) {
+    if(super.inputActionPressed(action, repeat) == InputPropagation.HANDLED) {
+      return InputPropagation.HANDLED;
+    }
+
+    if(action == INPUT_ACTION_MENU_BACK.get() && !repeat) {
+      this.back();
+      return InputPropagation.HANDLED;
+    }
+
+    return InputPropagation.PROPAGATE;
+  }
+}
