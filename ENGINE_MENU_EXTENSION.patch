+package legend.game.modding.events.menu;
+
+import legend.core.lang.TextComponent;
+import legend.game.inventory.screens.MenuScreen;
+import org.legendofdragoon.modloader.registries.RegistryId;
+
+import java.util.Objects;
+import java.util.function.Function;
+
+/** A mod-contributed entry displayed in the generic More menu. */
+public record ExtensionMenuEntry(
+  RegistryId id,
+  TextComponent name,
+  int order,
+  Function<Runnable, ? extends MenuScreen> screenFactory
+) {
+  public ExtensionMenuEntry {
+    Objects.requireNonNull(id, "id");
+    Objects.requireNonNull(name, "name");
+    Objects.requireNonNull(screenFactory, "screenFactory");
+  }
+}
