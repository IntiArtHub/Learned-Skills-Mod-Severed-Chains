+++ b/src/main/java/legend/game/modding/events/menu/GatherExtensionMenuEntriesEvent.java
@@ -0,0 +1,30 @@
+package legend.game.modding.events.menu;
+
+import org.legendofdragoon.modloader.events.Event;
+import org.legendofdragoon.modloader.registries.RegistryId;
+
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Fired while the Main Menu gathers mod-contributed entries for its More submenu. */
+public final class GatherExtensionMenuEntriesEvent extends Event {
+  private static final Comparator<ExtensionMenuEntry> ORDER = Comparator
+    .comparingInt(ExtensionMenuEntry::order)
+    .thenComparing(entry -> entry.id().toString());
+
+  private final Map<RegistryId, ExtensionMenuEntry> entries = new LinkedHashMap<>();
+
+  /** Rejects duplicate stable IDs so the menu cannot contain ambiguous entries. */
+  public void add(final ExtensionMenuEntry entry) {
+    if(this.entries.putIfAbsent(entry.id(), entry) != null) {
+      throw new IllegalArgumentException("Duplicate extension menu entry ID " + entry.id());
+    }
+  }
+
+  /** Returns an immutable deterministic snapshot ordered by order, then ID. */
+  public List<ExtensionMenuEntry> getEntries() {
+    return this.entries.values().stream().sorted(ORDER).toList();
+  }
+}
