diff --git a/src/test/java/legend/game/inventory/screens/ExtensionMenuTest.java b/src/test/java/legend/game/inventory/screens/ExtensionMenuTest.java
new file mode 100644
index 000000000..3a7db2875
--- /dev/null
+++ b/src/test/java/legend/game/inventory/screens/ExtensionMenuTest.java
@@ -0,0 +1,76 @@
+package legend.game.inventory.screens;
+
+import legend.core.lang.RawText;
+import legend.game.modding.events.menu.ExtensionMenuEntry;
+import legend.game.modding.events.menu.GatherExtensionMenuEntriesEvent;
+import org.junit.jupiter.api.Test;
+import org.legendofdragoon.modloader.registries.RegistryId;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class ExtensionMenuTest {
+  private static ExtensionMenuEntry entry(final String id, final int order) {
+    return new ExtensionMenuEntry(new RegistryId("test", id), new RawText(id), order, unload -> new ProbeScreen(unload));
+  }
+
+  @Test
+  void mainMenuVisibilityAndRetailLayoutRemainConditionalAndFixed() {
+    assertFalse(MainMenuScreen.shouldShowMore(new GatherExtensionMenuEntriesEvent().getEntries()));
+
+    final GatherExtensionMenuEntriesEvent event = new GatherExtensionMenuEntriesEvent();
+    event.add(entry("one", 0));
+    assertTrue(MainMenuScreen.shouldShowMore(event.getEntries()));
+    assertEquals(14, MainMenuScreen.RETAIL_BUTTON_COUNT);
+    assertEquals(7, MainMenuScreen.BUTTONS_PER_COLUMN);
+    assertEquals(5, MainMenuScreen.FIRST_BLANK_INDEX);
+    assertEquals(11, MainMenuScreen.EXTENSION_MENU_INDEX);
+  }
+
+  @Test
+  void entriesAreOrderedByOrderThenStableId() {
+    final GatherExtensionMenuEntriesEvent event = new GatherExtensionMenuEntriesEvent();
+    event.add(entry("z", 10));
+    event.add(entry("b", 5));
+    event.add(entry("a", 5));
+
+    assertEquals(java.util.List.of("test:a", "test:b", "test:z"),
+      event.getEntries().stream().map(value -> value.id().toString()).toList());
+  }
+
+  @Test
+  void duplicateIdsAreRejectedWithoutReplacingTheFirstEntry() {
+    final GatherExtensionMenuEntriesEvent event = new GatherExtensionMenuEntriesEvent();
+    final ExtensionMenuEntry first = entry("duplicate", 1);
+    event.add(first);
+
+    assertThrows(IllegalArgumentException.class, () -> event.add(entry("duplicate", 2)));
+    assertSame(first, event.getEntries().getFirst());
+  }
+
+  @Test
+  void extensionCollectionHasNoSevenEntryCapAndFactoryReceivesOneLevelUnload() {
+    final GatherExtensionMenuEntriesEvent event = new GatherExtensionMenuEntriesEvent();
+    for(int i = 0; i < 12; i++) event.add(entry("entry_" + i, i));
+    assertEquals(12, event.getEntries().size());
+    assertEquals(7, ExtensionMenuScreen.VISIBLE_ROWS);
+
+    final AtomicBoolean poppedOneLevel = new AtomicBoolean();
+    final ProbeScreen screen = (ProbeScreen)ExtensionMenuScreen.createScreen(event.getEntries().getFirst(), () -> poppedOneLevel.set(true));
+    screen.back();
+    assertTrue(poppedOneLevel.get());
+  }
+
+  private static final class ProbeScreen extends MenuScreen {
+    private final Runnable unload;
+
+    private ProbeScreen(final Runnable unload) { this.unload = unload; }
+    private void back() { this.unload.run(); }
+    @Override protected void render() { }
+  }
+}
